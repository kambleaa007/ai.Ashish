    {
      "name": "GraphQL",
      "item": [
        {
          "name": "GraphQL Query - List Warehouses",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query {\n  warehouses(page: 1, limit: 10) {\n    data {\n      id\n      name\n      location\n      capacity\n      manager\n      contact\n    }\n    pageInfo {\n      page\n      limit\n      total\n      totalPages\n    }\n  }\n}"
              }
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": ["{{base_url}}"],
              "path": ["graphql"]
            }
          },
          "response": []
        },
        {
          "name": "GraphQL Mutation - Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation {\n  createProduct(\n    name: \"GraphQL Test Product\"\n    sku: \"GQL001\"\n    price: 99.99\n    category: \"Test\"\n    supplier: \"Test Supplier\"\n  ) {\n    id\n    name\n    sku\n    price\n  }\n}"
              }
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": ["{{base_url}}"],
              "path": ["graphql"]
            }
          },
          "response": []
        },
        {
          "name": "GraphQL Query - Get Low Stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query {\n  lowStockItems(page: 1, limit: 10) {\n    data {\n      id\n      productId\n      quantity\n      status\n      minThreshold\n    }\n    pageInfo {\n      total\n      totalPages\n    }\n  }\n}"
              }
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": ["{{base_url}}"],
              "path": ["graphql"]
            }
          },
          "response": []
