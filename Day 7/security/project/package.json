{
  "name": "secure-notes-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p .",
    "audit": "npm audit --omit=dev",
    "semgrep": "semgrep --config .semgrep --config p/typescript --config p/owasp-top-ten --config p/nodejsscan src",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate || true"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.40.3",
    "cookie-parser": "^1.4.6",
    "cookie-session": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "openid-client": "^5.6.5",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "prisma": "^5.22.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "description": "A minimal but production-shaped Express + TypeScript API that ties every module together.",
